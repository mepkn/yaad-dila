{
  "name": "app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start -c",
    "dev:usb": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8090 tcp:8090 && expo start -c --localhost",
    "android": "expo start -c --android",
    "ios": "expo start -c --ios",
    "web": "expo start -c --web",
    "clean": "rm -rf .expo node_modules",
    "build:dev": "npx eas-cli build -p android --profile development --local --output build-dev-client.apk",
    "build:dev:cloud": "npx eas-cli build -p android --profile development",
    "build:prod": "npx eas-cli build -p android --profile production --local --output yaad-dila.apk",
    "build:prod:cloud": "npx eas-cli build -p android --profile production",
    "install:apk": "adb install -r"
  },
  "dependencies": {
