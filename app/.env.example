# Copy to .env and pick ONE of the two dev modes below. No secrets here — just
# the server address. Only affects Metro/development; production builds bake
# their URL from eas.json and ignore this file entirely.

# --- USB / adb mode (default — no Wi-Fi dependency) -------------------------
# Backend: cd backend && ./pocketbase serve        (loopback binding is fine)
# App:     npm run dev:usb                          (sets adb reverse 8081+8090)
EXPO_PUBLIC_POCKETBASE_URL=http://localhost:8090

# --- Wi-Fi mode (fallback — phone and Mac on the same network) ---------------
# Backend: cd backend && ./pocketbase serve --http=0.0.0.0:8090
# App:     npm run dev
# Use your Mac's LAN IP (ipconfig getifaddr en0), never localhost.
# EXPO_PUBLIC_POCKETBASE_URL=http://192.168.0.176:8090
