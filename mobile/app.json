{
  "expo": {
    "name": "Suchna",
    "slug": "suchna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "suchna",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.pknspace.suchna",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Suchna converts your speech to text to create reminders.",
        "NSMicrophoneUsageDescription": "Suchna uses the microphone so you can create reminders by voice."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#8CC2F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pknspace.suchna",
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO",
        "REQUEST_INSTALL_PACKAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EEF5FD",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#09090B"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Suchna uses the microphone so you can create reminders by voice.",
          "speechRecognitionPermission": "Suchna converts your speech to text to create reminders.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5A95D1",
          "defaultChannel": "reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd34189c-f5c9-430f-a7da-d0bcd57a1fe1"
      }
    },
    "owner": "mepkn",
    "platforms": [
      "android",
      "ios"
    ]
  }
}
