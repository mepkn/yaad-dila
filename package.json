{
  "name": "yaad-dila",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "mobile:install": "npm --prefix mobile install",
    "start": "npm --prefix mobile run start",
    "android": "npm --prefix mobile run android",
    "backend": "convex dev",
    "lint": "eslint .",
    "typecheck": "tsc -p convex --noEmit",
    "test": "vitest run",
    "icons": "npm --prefix mobile run icons",
    "deploy:backend": "scripts/deploy-backend.sh",
    "build:android:preview": "scripts/build-android.sh preview cloud",
    "build:android:preview:local": "scripts/build-android.sh preview local",
    "build:android:production": "scripts/build-android.sh production cloud",
    "build:android:production:local": "scripts/build-android.sh production local",
    "eas": "scripts/eas.sh",
    "check": "npm run typecheck && npm run lint && npm test && npm --prefix mobile run check",
    "submit:android": "scripts/eas.sh submit --platform android --profile production"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "convex": "^1.46.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "convex-test": "^0.0.60",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
